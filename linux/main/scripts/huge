#!/usr/bin/env python3
"""
huge - Hugepages allocator and monitor

Usage:
    huge           Show current hugepages status
    huge list      List processes currently using hugepages
    huge 0         Release all hugepages
    huge <N>       Allocate <N> hugepages (2048kB)
"""

from __future__ import annotations

import argparse
import os
import sys
import time
from pathlib import Path


# -- Constants -----------------------------------------------------------------

HUGE_DIR = Path("/sys/kernel/mm/hugepages/hugepages-2048kB")
NR_HUGEPAGES = HUGE_DIR / "nr_hugepages"
FREE_HUGEPAGES = HUGE_DIR / "free_hugepages"
DROP_CACHES = Path("/proc/sys/vm/drop_caches")
COMPACT_MEMORY = Path("/proc/sys/vm/compact_memory")

TIMEOUT = 30
SPINNER = "|/-\\"


# -- Sysfs helpers -------------------------------------------------------------

def read_sysfs(path: Path) -> int:
    return int(path.read_text().strip())


def write_sysfs(path: Path, val: str) -> None:
    path.write_text(val)


# -- Core functions ------------------------------------------------------------

def show_status() -> None:
    try:
        current = read_sysfs(NR_HUGEPAGES)
        free = read_sysfs(FREE_HUGEPAGES)
    except OSError as e:
        print(f"ERROR: Reading hugepages status failed: {e}")
        sys.exit(1)

    print(f"Current Allocated Hugepages: {current}")
    print(f"Current Free Hugepages:      {free}")


def list_users() -> None:
    print("Scanning for processes using hugepages...")
    # Store tuples of (PID, Command, Size in kB)
    users: list[tuple[int, str, int]] = []

    for pid_str in os.listdir("/proc"):
        if not pid_str.isdigit():
            continue
        pid = int(pid_str)
        comm = "unknown"
        huge_kb = 0
        try:
            with open(f"/proc/{pid}/status", "r") as f:
                for line in f:
                    if line.startswith("Name:"):
                        comm = line.split(maxsplit=1)[1].strip()
                    elif line.startswith("HugetlbPages:"):
                        huge_kb = int(line.split()[1])
                        # Assuming HugetlbPages comes after Name in the status file
                        break

            if huge_kb > 0:
                users.append((pid, comm, huge_kb))
        except OSError:
            continue

    if not users:
        print("DONE: No processes are currently using hugepages.")
        return

    print(f"DONE: Found {len(users)} process(es) using hugepages:")
    for pid, comm, kb in users:
        pages = kb // 2048
        mb = kb // 1024
        if mb >= 1024:
            size_str = f"{pages} pages ({mb / 1024:.2f} GB)"
        else:
            size_str = f"{pages} pages ({mb} MB)"

        print(f"  PID: {pid:<8} Size: {size_str:<25} Command: {comm}")


def require_root(action: str) -> None:
    if os.getuid() != 0:
        print(f"ERROR: Modifying hugepages requires root. Use: sudo huge {action}")
        sys.exit(1)


def release_hugepages() -> None:
    require_root("0")
    print("Releasing all hugepages...")
    write_sysfs(NR_HUGEPAGES, "0")
    print("DONE: Memory restored to host.")


def check_memory_available(needed_pages: int) -> None:
    needed_kb = needed_pages * 2048
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemAvailable:"):
                    avail_kb = int(line.split()[1])
                    if needed_kb > avail_kb:
                        print(f"ERROR: Cannot allocate {needed_pages} hugepages ({needed_kb // 1024} MB).")
                        print(f"Only {avail_kb // 1024} MB of memory is currently available.")
                        sys.exit(1)
                    return
    except Exception as e:
        print(f"WARNING: Could not check MemAvailable: {e}")


def allocate_hugepages(needed: int) -> None:
    require_root(str(needed))
    check_memory_available(needed)
    print(f"Preparing allocation for {needed} hugepages...")

    # Drop caches once at the beginning to maximize available memory
    try:
        write_sysfs(DROP_CACHES, "3")
    except OSError as e:
        print(f"WARNING: Failed to drop caches: {e}")

    success = False
    allocated = 0

    for i in range(TIMEOUT):
        # Force memory compaction
        try:
            write_sysfs(COMPACT_MEMORY, "1")
        except OSError:
            pass

        # Request allocation (Kernel incrementally adds pages as space frees up)
        write_sysfs(NR_HUGEPAGES, str(needed))
        allocated = read_sysfs(NR_HUGEPAGES)

        if allocated >= needed:
            success = True
            print("\r\033[K", end="", flush=True)  # Clear the line completely
            break

        # Display spinner and current status on the same line
        spin = SPINNER[i % len(SPINNER)]
        print(f"\r{spin} Compacting... ({allocated} / {needed})", end="", flush=True)
        time.sleep(1)

    if success:
        print(f"DONE: Successfully allocated {allocated} hugepages.")
    else:
        print("\r\033[K", end="", flush=True)
        print("FAIL: Timeout reached! Memory fragmentation is too high.")
        print(f"Only managed to get {allocated} / {needed}.")
        print("Reverting to baseline parameters...")
        write_sysfs(NR_HUGEPAGES, "0")
        sys.exit(1)


# -- Entry point ---------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="huge",
        description="Hugepages allocator and monitor.",
    )
    parser.add_argument(
        "action",
        nargs="?",
        help="Number of hugepages to allocate, 'list' to show users, or '0' to release. Omit to show status.",
    )
    args = parser.parse_args()

    if args.action is None:
        show_status()
        return

    if args.action == "list":
        list_users()
        return

    try:
        count = int(args.action)
    except ValueError:
        print(f"ERROR: Invalid argument '{args.action}'. Expected a number or 'list'.")
        sys.exit(1)

    if count == 0:
        release_hugepages()
    elif count > 0:
        allocate_hugepages(count)
    else:
        print("ERROR: Number of hugepages cannot be negative.")
        sys.exit(1)


if __name__ == "__main__":
    main()
