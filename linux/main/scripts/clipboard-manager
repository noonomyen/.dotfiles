#!/bin/sh

# Mutex / Toggle: If wofi for Clipboard is already running, kill it and exit
if pgrep -f "wofi .* -p Clipboard" >/dev/null 2>&1; then
    pkill -f "wofi .* -p Clipboard"
    exit 0
fi

USE_GNOME=false
ACTION=""

for arg in "$@"; do
    case "$arg" in
        --gnome)
            USE_GNOME=true
            ;;
        wipe|clear)
            ACTION="wipe"
            ;;
        *)
            ;;
    esac
done

if [ "$USE_GNOME" = true ]; then
    case "$ACTION" in
        wipe)
            gpaste-client empty
            ;;
        *)
            SELECTED=$(gpaste-client --use-index --oneline history | head -n 50 | wofi --dmenu -p "Clipboard")
            if [ -n "$SELECTED" ]; then
                INDEX=$(echo "$SELECTED" | cut -d':' -f1)
                gpaste-client --use-index select "$INDEX"
            fi
            ;;
    esac
else
    case "$ACTION" in
        wipe)
            cliphist wipe
            ;;
        *)
            SELECTED=$(cliphist list | head -n 50 | wofi --dmenu -p "Clipboard")
            if [ -n "$SELECTED" ]; then
                printf '%s\n' "$SELECTED" | cliphist decode | wl-copy
            fi
            ;;
    esac
fi
