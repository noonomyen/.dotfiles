# Intel integrated GPU (PCI 0000:00:02.0)
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ENV{ID_PATH}=="pci-0000:00:02.0", SYMLINK+="dri/igpu"
SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", ENV{ID_PATH}=="pci-0000:00:02.0", SYMLINK+="dri/igpu-render"

# NVIDIA discrete GPU (PCI 0000:01:00.0)
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ENV{ID_PATH}=="pci-0000:01:00.0", SYMLINK+="dri/dgpu"
SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", ENV{ID_PATH}=="pci-0000:01:00.0", SYMLINK+="dri/dgpu-render"
